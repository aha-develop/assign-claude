{
  "name": "aha-develop.assign-claude",
  "description": "Claude",
  "version": "2.0.0",
  "author": "Aha! (support@aha.io)",
  "repository": {
    "type": "git",
    "url": "https://github.com/aha-develop/assign-claude"
  },
  "license": "MIT",
  "scripts": {
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "^16.14.68",
    "aha-cli": "^1.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^4.9.5"
  },
  "ahaExtension": {
    "cspSources": [
      "https://api.github.com"
    ],
    "contributes": {
      "views": {
        "assignClaudeButton": {
          "title": "Claude Code",
          "host": "attribute",
          "entryPoint": "src/views/AssignClaudeButton.tsx",
          "recordTypes": [
            "Feature",
            "Requirement"
          ]
        }
      },
      "settings": {
        "repository": {
          "title": "GitHub Repository",
          "description": "Format: owner/repo (e.g., myorg/myrepo)",
          "type": "string",
          "required": true,
          "scope": [
            "account",
            "team",
            "user"
          ]
        },
        "triggerMode": {
          "title": "Claude Trigger",
          "description": "Create a draft pull request, then mention Claude or dispatch a workflow.",
          "type": "string",
          "default": "mention",
          "options": [
            {
              "label": "Mention @claude on the pull request",
              "value": "mention"
            },
            {
              "label": "Dispatch a GitHub workflow",
              "value": "workflow"
            }
          ],
          "scope": [
            "account",
            "team",
            "user"
          ]
        },
        "workflowFile": {
          "title": "Claude Workflow File",
          "description": "Workflow to dispatch in workflow mode (for example, claude.yml).",
          "type": "string",
          "default": "claude.yml",
          "scope": [
            "account",
            "team",
            "user"
          ]
        },
        "pullRequestLabels": {
          "title": "Pull Request Labels",
          "description": "Labels to apply to created pull requests, one label per line.",
          "type": "string",
          "scope": [
            "account",
            "team",
            "user"
          ]
        },
        "claudeHandle": {
          "title": "Claude Handle",
          "description": "The handle to mention in pull request mention mode (e.g., claude)",
          "type": "string",
          "default": "claude",
          "scope": [
            "account",
            "team"
          ]
        },
        "customInstructions": {
          "title": "Custom Instructions for Claude",
          "description": "Additional instructions to include in the task sent to Claude.",
          "type": "string",
          "scope": [
            "account",
            "team",
            "user"
          ]
        }
      }
    }
  },
  "dependencies": {
    "@aha-app/aha-develop-react": "^1.5.1"
  }
}
