{
  "name": "aha-develop.assign-claude",
  "description": "Claude",
  "version": "2.1.0",
  "author": "Aha! (support@aha.io)",
  "repository": {
    "type": "git",
    "url": "https://github.com/aha-develop/assign-claude"
  },
  "license": "MIT",
  "scripts": {
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^16.14.68",
    "aha-cli": "^1.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "~5.5.4"
  },
  "ahaExtension": {
    "cspSources": [
      "https://api.github.com"
    ],
    "contributes": {
      "views": {
        "assignClaudeButton": {
          "title": "Claude Code",
          "host": "attribute",
          "entryPoint": "src/views/AssignClaudeButton.tsx",
          "recordTypes": [
            "Feature",
            "Requirement"
          ]
        }
      },
      "settings": {
        "repository": {
          "title": "GitHub Repository",
          "description": "Format: owner/repo (e.g., myorg/myrepo)",
          "type": "string",
          "required": true,
          "array": true,
          "scope": [
            "account",
            "team",
            "user"
          ]
        },
        "triggerMode": {
          "title": "Claude Trigger",
          "description": "OAuth trigger: mention @claude (default) or dispatch a workflow accepting pr_number. A configured GitHub App always uses workflow dispatch.",
          "type": "string",
          "default": "mention",
          "options": [
            {
              "label": "Mention @claude (standard workflow)",
              "value": "mention"
            },
            {
              "label": "Dispatch a workflow (template required)",
              "value": "workflow"
            }
          ],
          "scope": [
            "account",
            "team",
            "user"
          ]
        },
        "workflowFile": {
          "title": "Workflow File",
          "description": "Workflow on the default branch. OAuth dispatch uses pr_number; App dispatch uses branch, base_branch, title, and labels. See examples/claude.yml.",
          "type": "string",
          "default": "claude.yml",
          "scope": [
            "account",
            "team",
            "user"
          ]
        },
        "pullRequestLabels": {
          "title": "Pull Request Labels",
          "description": "Labels to apply to created pull requests, one label per line.",
          "type": "string",
          "scope": [
            "account",
            "team",
            "user"
          ]
        },
        "claudeHandle": {
          "title": "Claude Handle",
          "description": "The handle to mention in pull request mention mode (e.g., claude)",
          "type": "string",
          "default": "claude",
          "scope": [
            "account",
            "team"
          ]
        },
        "customInstructions": {
          "title": "Custom Instructions for Claude",
          "description": "Additional instructions to include in the task sent to Claude.",
          "type": "string",
          "scope": [
            "account",
            "team",
            "user"
          ]
        },
        "githubAppId": {
          "title": "GitHub App ID",
          "description": "Optional. Configure this ID and the private key to use an installed GitHub App with workflow dispatch. Leave empty to keep GitHub OAuth.",
          "type": "string",
          "scope": [
            "account"
          ]
        },
        "githubAppPrivateKey": {
          "title": "GitHub App Private Key",
          "description": "Optional RSA PEM key for the configured App. Stored as an account secret and used only by server-side extension code.",
          "type": "secret",
          "scope": [
            "account"
          ]
        }
      },
      "events": {
        "assignClaude": {
          "title": "Send work through the GitHub App",
          "entryPoint": "src/events/assignClaude.ts",
          "handles": [
            "aha-develop.assign-claude.assignWork"
          ]
        }
      }
    }
  },
  "dependencies": {
    "@aha-app/aha-develop-react": "^1.5.1",
    "node-forge": "^1.4.0",
    "zod": "4.3.6"
  }
}
